// The public demo (`npm run deploy:demo`, scripts/deploy/demo.mjs): static files only.
// No Worker code, no login, no database. Never point it at a real bank: the script checks.
{
  "name": "clean-tcf-demo",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-demo",
    "not_found_handling": "single-page-application"
  }
}
